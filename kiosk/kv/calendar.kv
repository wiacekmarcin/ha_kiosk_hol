#:import config kiosk.config

# Obszar dotykowy kartki na ekranie startowym (lekkie podświetlenie przy wciśnięciu)
<TouchBox@ButtonBehavior+BoxLayout>:
    canvas.after:
        Color:
            rgba: 1, 1, 1, (0.05 if self.state == "down" else 0)
        Rectangle:
            pos: self.pos
            size: self.size

# ======================================================================================
# Tabela miesiąca
# ======================================================================================

# Dzień w tabeli: numer (czerwony w niedziele i święta), do 3 wydarzeń w kolorach kalendarzy
<MonthCell@ButtonBehavior+BoxLayout>:
    number: ""
    events_text: ""
    other_month: False
    today: False
    red: False
    orientation: "vertical"
    padding: [8, 4, 6, 4]
    spacing: 0
    canvas.before:
        Color:
            rgba: (config.COLOR_ACCENT_SOFT if self.today else config.COLOR_CARD) if not self.other_month else config.COLOR_BG
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: (1, 1, 1, 0.08) if self.state == "down" else (0, 0, 0, 0)
        Rectangle:
            pos: self.pos
            size: self.size
    Label:
        text: root.number
        font_size: "22sp"
        bold: root.today
        color: (config.COLOR_ERROR if root.red else config.COLOR_TEXT) if not root.other_month else config.COLOR_TEXT_DIM
        size_hint_y: None
        height: 28
        text_size: self.size
        halign: "left"
        valign: "middle"
    Label:
        text: root.events_text
        markup: True
        font_size: "13sp"
        opacity: 0.5 if root.other_month else 1
        text_size: self.size
        halign: "left"
        valign: "top"

<MonthDialog>:
    size_hint: 1, 1
    overlay_color: config.COLOR_BG
    background: ""
    background_color: 0, 0, 0, 0
    BoxLayout:
        orientation: "vertical"
        padding: [24, 12, 24, 16]
        spacing: 8
        canvas.before:
            Color:
                rgba: config.COLOR_BG
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            size_hint_y: None
            height: 72
            spacing: 16
            CloseButton:
                pos_hint: {"center_y": 0.5}
                on_release: root.dismiss()
            Label:
                text: root.title
                font_size: "34sp"
                bold: True
                text_size: self.size
                halign: "left"
                valign: "middle"
            Label:
                text: "Trwa ładowanie…" if root.loading else ""
                font_size: "17sp"
                color: config.COLOR_TEXT_DIM
                size_hint_x: None
                width: 170
            SettingsButton:
                icon: "calendar-today"
                text: "Dziś"
                pos_hint: {"center_y": 0.5}
                on_release: root.this_month()
            RoundIconButton:
                icon: "chevron-left"
                pos_hint: {"center_y": 0.5}
                on_release: root.prev_month()
            RoundIconButton:
                icon: "chevron-right"
                pos_hint: {"center_y": 0.5}
                on_release: root.next_month()
        # nagłówek dni tygodnia
        GridLayout:
            cols: 7
            size_hint_y: None
            height: 30
            Label:
                text: "pon."
                color: config.COLOR_TEXT_DIM
            Label:
                text: "wt."
                color: config.COLOR_TEXT_DIM
            Label:
                text: "śr."
                color: config.COLOR_TEXT_DIM
            Label:
                text: "czw."
                color: config.COLOR_TEXT_DIM
            Label:
                text: "pt."
                color: config.COLOR_TEXT_DIM
            Label:
                text: "sob."
                color: config.COLOR_TEXT_DIM
            Label:
                text: "niedz."
                color: config.COLOR_ERROR
        GridLayout:
            id: grid
            cols: 7
            spacing: 3

# ======================================================================================
# Lista wydarzeń
# ======================================================================================

<EventsDayHeader@Label>:
    today: False
    font_size: "21sp"
    bold: True
    color: config.COLOR_ACCENT if self.today else config.COLOR_TEXT
    size_hint_y: None
    height: 52
    text_size: self.width, None
    halign: "left"
    valign: "bottom"
    padding: [4, 6]

<EventsEmpty@Label>:
    font_size: "19sp"
    color: config.COLOR_TEXT_DIM
    size_hint_y: None
    height: 120

# Wydarzenie: ikona rodzaju kalendarza w kolorowym kółku, nazwa, godziny, kalendarz, miejsce, opis
<EventCard@BoxLayout>:
    icon: "calendar"
    color: config.COLOR_ACCENT
    title: ""
    time_text: ""
    calendar_text: ""
    location: ""
    description: ""
    size_hint_y: None
    height: max(96, info.minimum_height + 24)
    padding: [16, 12]
    spacing: 18
    canvas.before:
        Color:
            rgba: config.COLOR_CARD
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [config.CARD_RADIUS]
    AnchorLayout:
        size_hint_x: None
        width: 64
        anchor_y: "top"
        Widget:
            size_hint: None, None
            size: 60, 60
            canvas:
                Color:
                    # kolor kalendarza z przezroczystością; przed przypisaniem koloru (None) - przezroczyste
                    rgba: (root.color[0], root.color[1], root.color[2], 0.22) if root.color else (0, 0, 0, 0)
                Ellipse:
                    pos: self.pos
                    size: self.size
            Icon:
                icon: root.icon
                font_size: "32sp"
                color: root.color or config.COLOR_ACCENT
                center: self.parent.center
    BoxLayout:
        id: info
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        spacing: 4
        Label:
            text: root.title
            font_size: "22sp"
            bold: True
            size_hint_y: None
            height: self.texture_size[1]
            text_size: self.width, None
            halign: "left"
        Label:
            text: root.time_text + "   ·   " + root.calendar_text
            font_size: "17sp"
            color: config.COLOR_TEXT_DIM
            size_hint_y: None
            height: self.texture_size[1]
            text_size: self.width, None
            halign: "left"
        Label:
            text: ("Miejsce: " + root.location) if root.location else ""
            font_size: "17sp"
            size_hint_y: None
            height: self.texture_size[1] if root.location else 0
            text_size: self.width, None
            halign: "left"
        Label:
            text: root.description
            font_size: "16sp"
            color: config.COLOR_TEXT_DIM
            size_hint_y: None
            height: self.texture_size[1] if root.description else 0
            text_size: self.width, None
            halign: "left"

<EventsDialog>:
    size_hint: 1, 1
    overlay_color: config.COLOR_BG
    background: ""
    background_color: 0, 0, 0, 0
    BoxLayout:
        orientation: "vertical"
        padding: [24, 12, 24, 16]
        spacing: 10
        canvas.before:
            Color:
                rgba: config.COLOR_BG
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            size_hint_y: None
            height: 72
            spacing: 16
            CloseButton:
                pos_hint: {"center_y": 0.5}
                on_release: root.dismiss()
            BoxLayout:
                orientation: "vertical"
                padding: [0, 6]
                Label:
                    text: root.title
                    font_size: "28sp"
                    bold: True
                    text_size: self.size
                    halign: "left"
                    valign: "bottom"
                Label:
                    text: root.subtitle
                    font_size: "17sp"
                    color: config.COLOR_TEXT_DIM
                    text_size: self.size
                    halign: "left"
                    valign: "top"
            Label:
                text: "Trwa ładowanie…" if root.loading else ""
                font_size: "17sp"
                color: config.COLOR_TEXT_DIM
                size_hint_x: None
                width: 170
        ScrollView:
            do_scroll_x: False
            bar_width: 6
            BoxLayout:
                id: list
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: 10
                padding: [0, 0, 10, 10]
        BoxLayout:
            size_hint_y: None
            height: 72
            Widget:
            SettingsButton:
                icon: "calendar-plus"
                text: "Dodaj wydarzenie"
                primary: True
                height: 64
                pos_hint: {"center_y": 0.5}
                on_release: root.add_event()

# ======================================================================================
# Formularz nowego wydarzenia
# ======================================================================================

<CalendarChip@ButtonBehavior+BoxLayout>:
    text: ""
    icon: "calendar"
    color: config.COLOR_ACCENT
    entity_id: ""
    selected: False
    size_hint: None, None
    height: 56
    width: self.minimum_width
    padding: [16, 0, 20, 0]
    spacing: 8
    canvas.before:
        Color:
            rgba: config.COLOR_ACCENT if self.selected else config.COLOR_CARD
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [28]
    Icon:
        icon: root.icon
        font_size: "24sp"
        color: (1, 1, 1, 1) if root.selected else (root.color or config.COLOR_ACCENT)
        pos_hint: {"center_y": 0.5}
    FitLabel:
        text: root.text
        font_size: "18sp"
        color: (1, 1, 1, 1) if root.selected else config.COLOR_TEXT

<FormRow@BoxLayout>:
    size_hint_y: None
    height: 64
    spacing: 14

<FormLabel@Label>:
    font_size: "19sp"
    color: config.COLOR_TEXT_DIM
    size_hint_x: None
    width: 150
    text_size: self.size
    halign: "left"
    valign: "middle"

<EventFormDialog>:
    size_hint: 1, 1
    overlay_color: config.COLOR_BG
    background: ""
    background_color: 0, 0, 0, 0
    BoxLayout:
        orientation: "vertical"
        padding: [24, 12, 24, 16]
        spacing: 8
        canvas.before:
            Color:
                rgba: config.COLOR_BG
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            size_hint_y: None
            height: 72
            spacing: 16
            CloseButton:
                pos_hint: {"center_y": 0.5}
                on_release: root.dismiss()
            Label:
                text: "Nowe wydarzenie"
                font_size: "28sp"
                bold: True
                text_size: self.size
                halign: "left"
                valign: "middle"
        ScrollView:
            do_scroll_x: False
            bar_width: 6
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: 10
                padding: [0, 0, 12, 0]
                FormRow:
                    height: max(64, calendars.height)
                    FormLabel:
                        text: "Kalendarz"
                    StackLayout:
                        id: calendars
                        spacing: 10
                        size_hint_y: None
                        height: max(56, self.minimum_height)
                FormRow:
                    FormLabel:
                        text: "Nazwa"
                    SettingsInput:
                        id: summary
                        hint_text: "np. Wizyta u lekarza"
                FormRow:
                    FormLabel:
                        text: "Data"
                    RoundIconButton:
                        icon: "minus"
                        pos_hint: {"center_y": 0.5}
                        on_release: root.change_day(-1)
                    Label:
                        text: root.day_text
                        font_size: "21sp"
                        size_hint_x: None
                        width: 380
                    RoundIconButton:
                        icon: "plus"
                        pos_hint: {"center_y": 0.5}
                        on_release: root.change_day(+1)
                    Widget:
                    Label:
                        text: "Cały dzień"
                        font_size: "19sp"
                        size_hint_x: None
                        width: 120
                    IconButton:
                        icon: "toggle-switch" if root.all_day else "toggle-switch-off"
                        font_size: "52sp"
                        size: 76, 56
                        color: config.COLOR_ACCENT if root.all_day else config.COLOR_TEXT_DIM
                        pos_hint: {"center_y": 0.5}
                        on_release: root.all_day = not root.all_day
                FormRow:
                    opacity: 0.3 if root.all_day else 1
                    disabled: root.all_day
                    FormLabel:
                        text: "Od"
                    RoundIconButton:
                        icon: "minus"
                        pos_hint: {"center_y": 0.5}
                        on_release: root.change_time("start", -1)
                    Label:
                        text: root.start_text
                        font_size: "24sp"
                        size_hint_x: None
                        width: 110
                    RoundIconButton:
                        icon: "plus"
                        pos_hint: {"center_y": 0.5}
                        on_release: root.change_time("start", +1)
                    Widget:
                        size_hint_x: None
                        width: 40
                    Label:
                        text: "Do"
                        font_size: "19sp"
                        color: config.COLOR_TEXT_DIM
                        size_hint_x: None
                        width: 50
                    RoundIconButton:
                        icon: "minus"
                        pos_hint: {"center_y": 0.5}
                        on_release: root.change_time("end", -1)
                    Label:
                        text: root.end_text
                        font_size: "24sp"
                        size_hint_x: None
                        width: 110
                    RoundIconButton:
                        icon: "plus"
                        pos_hint: {"center_y": 0.5}
                        on_release: root.change_time("end", +1)
                    Widget:
                FormRow:
                    FormLabel:
                        text: "Miejsce"
                    SettingsInput:
                        id: location
                        hint_text: "opcjonalnie"
                FormRow:
                    height: 110
                    FormLabel:
                        text: "Opis"
                        valign: "top"
                    SettingsInput:
                        id: description
                        multiline: True
                        height: 104
                        padding: [16, 12]
                        hint_text: "opcjonalnie"
        BoxLayout:
            size_hint_y: None
            height: 72
            spacing: 16
            Label:
                text: root.result
                font_size: "18sp"
                color: config.COLOR_OK if root.result_ok else config.COLOR_ERROR
                text_size: self.size
                halign: "left"
                valign: "middle"
            SettingsButton:
                icon: "close"
                text: "Anuluj"
                height: 64
                pos_hint: {"center_y": 0.5}
                on_release: root.dismiss()
            SettingsButton:
                icon: "content-save"
                text: "Zapisz"
                primary: True
                height: 64
                disabled: root.busy
                pos_hint: {"center_y": 0.5}
                on_release: root.save()
