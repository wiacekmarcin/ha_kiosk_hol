#:import config kiosk.config

# Blok opisu w prawej kolumnie okna "Słońce w roku"
<SunInfo@BoxLayout>:
    title: ""
    text: ""
    orientation: "vertical"
    size_hint_y: None
    height: 40 + text_label.texture_size[1]
    Label:
        text: root.title
        font_size: "16sp"
        color: config.COLOR_TEXT_DIM
        size_hint_y: None
        height: 30
        text_size: self.size
        halign: "left"
        valign: "middle"
    Label:
        id: text_label
        markup: True
        text: root.text
        font_size: "19sp"
        line_height: 1.1
        text_size: self.width, None
        size_hint_y: None
        height: self.texture_size[1]
        halign: "left"

<SunDialog>:
    size_hint: 1, 1                     # cały ekran
    overlay_color: config.COLOR_BG
    background: ""
    background_color: 0, 0, 0, 0
    BoxLayout:
        orientation: "vertical"
        padding: [24, 16, 24, 20]
        spacing: 12
        canvas.before:
            Color:
                rgba: config.COLOR_CARD
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24]

        BoxLayout:
            size_hint_y: None
            height: 64
            spacing: 16
            CloseButton:
                pos_hint: {"center_y": 0.5}
                on_release: root.dismiss()
            Label:
                text: root.title
                font_size: "24sp"
                text_size: self.size
                halign: "left"
                valign: "middle"
            Label:
                text: "Dotknij wykresu, aby zobaczyć wybrany dzień"
                font_size: "15sp"
                color: config.COLOR_TEXT_DIM
                text_size: self.size
                halign: "right"
                valign: "middle"

        BoxLayout:
            spacing: 24
            SunYearChart:
                days: root.days
                today: root.today

            # opisy
            BoxLayout:
                orientation: "vertical"
                size_hint_x: None
                width: 340
                spacing: 14
                Label:
                    text: "Dziś dzień trwa"
                    font_size: "16sp"
                    color: config.COLOR_TEXT_DIM
                    size_hint_y: None
                    height: 24
                    text_size: self.size
                    halign: "left"
                Label:
                    text: root.length_text
                    font_size: "44sp"
                    bold: True
                    color: config.COLOR_SUN_ICON
                    size_hint_y: None
                    height: 56
                    text_size: self.size
                    halign: "left"
                    valign: "middle"
                Label:
                    markup: True
                    text: root.change_text
                    font_size: "18sp"
                    size_hint_y: None
                    height: 28
                    text_size: self.size
                    halign: "left"
                    valign: "middle"
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: 3 * 40
                    SunRow:
                        icon: "weather-sunset-up"
                        label: "Wschód"
                        time: root.rise_text
                    SunRow:
                        icon: "weather-sunny"
                        label: "Górowanie"
                        time: root.noon_text
                    SunRow:
                        icon: "weather-sunset-down"
                        label: "Zachód"
                        time: root.set_text
                SunInfo:
                    title: "Najdłuższy dzień"
                    text: root.longest_text
                SunInfo:
                    title: "Najkrótszy dzień"
                    text: root.shortest_text
                SunInfo:
                    title: root.solstice_title
                    text: root.solstice_text
                Widget:
