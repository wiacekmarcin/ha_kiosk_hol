#:import config kiosk.config

# Najbliższa główna faza: tarcza, nazwa, data i "za N dni"
<MoonPhaseRow@BoxLayout>:
    phase: 0.0
    name: ""
    when: ""
    left: ""
    size_hint_y: None
    height: 62
    spacing: 14
    MoonDisc:
        phase: root.phase
        size_hint: None, None
        size: 40, 40
        pos_hint: {"center_y": 0.5}
    BoxLayout:
        orientation: "vertical"
        Label:
            text: root.name
            font_size: "19sp"
            bold: True
            text_size: self.size
            halign: "left"
            valign: "bottom"
        Label:
            text: root.when
            font_size: "16sp"
            color: config.COLOR_TEXT_DIM
            text_size: self.size
            halign: "left"
            valign: "top"
    Label:
        text: root.left
        font_size: "16sp"
        color: config.COLOR_ACCENT
        size_hint_x: None
        width: 90
        text_size: self.size
        halign: "right"
        valign: "middle"

# Dzień w kalendarzu faz: numer, tarcza i (gdy wypada) główna faza z godziną
<MoonDayCell@BoxLayout>:
    number: ""
    phase: 0.0
    today: False
    main: ""
    red: False
    orientation: "vertical"
    padding: [6, 4]
    spacing: 2
    canvas.before:
        Color:
            rgba: config.COLOR_ACCENT_SOFT if self.today else config.COLOR_BG
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8]
    Label:
        text: root.number
        font_size: "16sp"
        bold: root.today
        color: config.COLOR_ERROR if root.red else config.COLOR_TEXT
        size_hint_y: None
        height: 20
        text_size: self.size
        halign: "left"
        valign: "middle"
    AnchorLayout:
        MoonDisc:
            phase: root.phase
            size_hint: None, None
            size: [min(self.parent.width, self.parent.height, 44)] * 2
    Label:
        text: root.main
        font_size: "11sp"
        color: config.COLOR_SUN_ICON
        size_hint_y: None
        height: 28 if root.main else 0
        opacity: 1 if root.main else 0
        halign: "center"
        text_size: self.width, None

<MoonDialog>:
    size_hint: 1, 1                     # cały ekran
    overlay_color: config.COLOR_BG
    background: ""
    background_color: 0, 0, 0, 0
    BoxLayout:
        orientation: "vertical"
        padding: [24, 16, 24, 20]
        spacing: 12
        canvas.before:
            Color:
                rgba: config.COLOR_CARD
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [24]

        BoxLayout:
            size_hint_y: None
            height: 64
            spacing: 16
            CloseButton:
                pos_hint: {"center_y": 0.5}
                on_release: root.dismiss()
            Label:
                text: root.title
                font_size: "24sp"
                text_size: self.size
                halign: "left"
                valign: "middle"

        BoxLayout:
            spacing: 24
            # ===== dziś i najbliższe fazy =====
            BoxLayout:
                orientation: "vertical"
                size_hint_x: None
                width: 400
                spacing: 8
                BoxLayout:
                    size_hint_y: None
                    height: 170
                    spacing: 20
                    MoonDisc:
                        phase: root.phase
                        size_hint: None, None
                        size: 160, 160
                        pos_hint: {"center_y": 0.5}
                    BoxLayout:
                        orientation: "vertical"
                        padding: [0, 16]
                        Label:
                            text: root.phase_name
                            font_size: "24sp"
                            bold: True
                            text_size: self.width, None
                            size_hint_y: None
                            height: self.texture_size[1] + 8
                            halign: "left"
                        Label:
                            markup: True
                            text: root.details
                            font_size: "18sp"
                            line_height: 1.2
                            text_size: self.size
                            halign: "left"
                            valign: "top"
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: 80
                    SunRow:
                        icon: "arrow-up"
                        label: "Wschód Księżyca"
                        time: root.rise_text
                    SunRow:
                        icon: "arrow-down"
                        label: "Zachód Księżyca"
                        time: root.set_text
                Label:
                    text: "Najbliższe fazy"
                    font_size: "16sp"
                    color: config.COLOR_TEXT_DIM
                    size_hint_y: None
                    height: 36
                    text_size: self.size
                    halign: "left"
                    valign: "bottom"
                BoxLayout:
                    id: next_phases
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                Widget:

            # ===== kalendarz faz =====
            BoxLayout:
                orientation: "vertical"
                spacing: 8
                BoxLayout:
                    size_hint_y: None
                    height: 56
                    spacing: 12
                    RoundIconButton:
                        icon: "chevron-left"
                        pos_hint: {"center_y": 0.5}
                        on_release: root.prev_month()
                    Label:
                        text: root.month_title
                        font_size: "22sp"
                    RoundIconButton:
                        icon: "chevron-right"
                        pos_hint: {"center_y": 0.5}
                        on_release: root.next_month()
                GridLayout:
                    cols: 7
                    size_hint_y: None
                    height: 26
                    Label:
                        text: "pn"
                        color: config.COLOR_TEXT_DIM
                    Label:
                        text: "wt"
                        color: config.COLOR_TEXT_DIM
                    Label:
                        text: "śr"
                        color: config.COLOR_TEXT_DIM
                    Label:
                        text: "cz"
                        color: config.COLOR_TEXT_DIM
                    Label:
                        text: "pt"
                        color: config.COLOR_TEXT_DIM
                    Label:
                        text: "sb"
                        color: config.COLOR_TEXT_DIM
                    Label:
                        text: "nd"
                        color: config.COLOR_ERROR
                GridLayout:
                    id: month_grid
                    cols: 7
                    rows: 6
                    spacing: 6
