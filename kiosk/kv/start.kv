#:import config kiosk.config
#:import icons kiosk.icons
#:import pl kiosk.pl
#:import wicons kiosk.weather_icons

# ---------- elementy pomocnicze ----------

# Kolorowa ikona pogody (Meteocons): WeatherIcon(condition="rainy", night=False)
<WeatherIcon@Image>:
    condition: ""
    night: False
    source: wicons.path(self.condition, self.night)
    size_hint: None, None
    fit_mode: "contain"
    mipmap: True

# Karta reagująca na dotyk - lekkie podświetlenie przy wciśnięciu
<TouchCard@ButtonBehavior+Card>:
    canvas.after:
        Color:
            rgba: 1, 1, 1, (0.05 if self.state == "down" else 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [config.CARD_RADIUS]

<WeatherCard@TouchCard>:

<ForecastDay@BoxLayout>:
    day: ""
    condition: ""
    icon: ""
    high: ""
    low: ""
    drops: 0
    orientation: "vertical"
    spacing: 2
    Label:
        text: root.day
        font_size: "18sp"
        color: config.COLOR_TEXT_DIM
        size_hint_y: None
        height: 26
    AnchorLayout:
        WeatherIcon:
            condition: root.condition
            size: 66, 66
    Label:
        text: root.high
        font_size: "24sp"
        size_hint_y: None
        height: 32
    Label:
        text: root.low
        font_size: "18sp"
        color: config.COLOR_TEXT_DIM
        size_hint_y: None
        height: 24
    # intensywność opadów: 1-3 krople (puste = bez opadów)
    Label:
        text: icons.glyph("water") * int(root.drops)
        font_name: icons.FONT_NAME
        font_size: "22sp"
        color: config.COLOR_RAIN
        size_hint_y: None
        height: 28

# Kafelek czujnika: temperatura + wilgotność; "more" = trzy kropki (np. lista pomieszczeń)
<SensorTile@TouchCard>:
    name: ""
    value: ""
    unit: ""
    icon: ""
    humidity: ""
    more: False
    orientation: "vertical"
    padding: [20, 12, 12, 8]
    spacing: 0
    BoxLayout:
        size_hint_y: None
        height: 32
        padding: [0, 0, 8, 0]
        Label:
            text: root.name
            font_size: "20sp"
            color: config.COLOR_TEXT_DIM
            text_size: self.size
            halign: "left"
            valign: "middle"
        Icon:
            icon: root.icon
            pos_hint: {"center_y": 0.5}
    Label:
        markup: True
        text: "[size=36sp]{}[/size] [size=20sp][color=#949ba8]{}[/color][/size]".format(root.value, root.unit)
        text_size: self.size
        halign: "left"
        valign: "middle"
    BoxLayout:
        size_hint_y: None
        height: 40
        spacing: 8
        Icon:
            icon: "water-percent" if root.humidity else ""
            font_size: "22sp"
            color: config.COLOR_RAIN
            pos_hint: {"center_y": 0.5}
        Label:
            text: root.humidity
            font_size: "20sp"
            text_size: self.size
            halign: "left"
            valign: "middle"
        MoreDots:
            id: more
            opacity: 1 if root.more else 0
            disabled: not root.more
            pos_hint: {"center_y": 0.5}

# Wiersz na kartce: ikona + godzina (wschód / zachód słońca albo Księżyca)
<AstroRow@AnchorLayout>:
    icon: ""
    time: ""
    icon_color: config.COLOR_SUN_ICON
    align: "left"
    anchor_x: self.align
    size_hint_y: None
    height: 36
    BoxLayout:
        size_hint_x: None
        width: 30 + 8 + time_label.texture_size[0]
        spacing: 8
        Icon:
            icon: root.icon
            font_size: "24sp"
            color: root.icon_color
            size_hint_x: None
            width: 30
        Label:
            id: time_label
            text: root.time
            font_size: "22sp"
            bold: True
            size_hint_x: None
            width: self.texture_size[0]

<SunRow@BoxLayout>:
    icon: ""
    label: ""
    time: ""
    spacing: 12
    Icon:
        icon: root.icon
        font_size: "28sp"
        color: config.COLOR_SUN_ICON
        pos_hint: {"center_y": 0.5}
    Label:
        text: root.label
        font_size: "20sp"
        text_size: self.size
        halign: "left"
        valign: "middle"
    Label:
        text: root.time
        font_size: "26sp"
        bold: True
        text_size: self.size
        halign: "right"
        valign: "middle"

<CalendarDayHeader@BoxLayout>:
    day: ""
    date_text: ""
    size_hint_y: None
    height: 52
    padding: [12, 0]
    Label:
        text: root.day
        font_size: "20sp"
        text_size: self.size
        halign: "left"
        valign: "middle"
    Label:
        text: root.date_text
        font_size: "20sp"
        text_size: self.size
        halign: "right"
        valign: "middle"

<CalendarEvent@BoxLayout>:
    time_text: ""
    title: ""
    size_hint_y: None
    height: 44
    padding: [12, 0]
    spacing: 16
    Label:
        text: root.time_text
        font_size: "17sp"
        size_hint_x: None
        width: 130
        text_size: self.size
        halign: "left"
        valign: "middle"
    Widget:
        size_hint_x: None
        width: 12
        canvas:
            Color:
                rgba: config.COLOR_EVENT
            Ellipse:
                pos: self.center_x - 6, self.center_y - 6
                size: 12, 12
    Label:
        text: root.title
        font_size: "17sp"
        text_size: self.size
        halign: "left"
        valign: "middle"
        shorten: True

<CalendarEmpty@Label>:
    text: "Brak wydarzeń w tym tygodniu"
    color: config.COLOR_TEXT_DIM
    font_size: "18sp"
    size_hint_y: None
    height: 80

# Przełącznik widoku kalendarza (miesiąc / tydzień / lista)
<ViewToggle@ButtonBehavior+Icon>:
    view: ""
    current: ""
    first: False
    last: False
    size: 54, 38
    font_size: "22sp"
    text_size: self.size
    halign: "center"
    valign: "middle"
    color: (1, 1, 1, 1) if self.view == self.current else config.COLOR_ACCENT
    canvas.before:
        Color:
            rgba: config.COLOR_ACCENT if self.view == self.current else config.COLOR_ACCENT_SOFT
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [19 if self.first else 0, 19 if self.last else 0, 19 if self.last else 0, 19 if self.first else 0]

# ---------- ekran ----------

<StartScreen>:
    BoxLayout:
        padding: 16
        spacing: 16

        # ===== lewa kolumna =====
        BoxLayout:
            orientation: "vertical"
            spacing: 12

            # Zegar - dotknięcie otwiera "Kartkę z kalendarza"
            TouchCard:
                on_release: app.open_kartka()
                size_hint_y: None
                height: 132
                padding: [14, 8, 14, 8]
                spacing: 0
                # na górze numer wersji aplikacji; pod nim bateria tabletu: ikona, pod nią procent,
                # obok błyskawica tylko podczas ładowania (bateria ukryta, gdy jej brak - komputer)
                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: None
                    width: 110
                    padding: [0, 2, 0, 12]
                    spacing: 2
                    Label:
                        text: ("v" + app.app_version) if app.app_version else ""
                        font_size: "12sp"
                        color: config.COLOR_TEXT_DIM
                        size_hint_y: None
                        height: 16
                        text_size: self.size
                        halign: "left"
                        valign: "middle"
                    BoxLayout:
                        opacity: 1 if app.tablet_battery_text else 0
                        AnchorLayout:
                            size_hint_x: None
                            width: 44
                            Icon:
                                icon: app.tablet_battery_icon
                                font_size: "34sp"
                                color: app.tablet_battery_color
                        # podczas ładowania: błyskawica i moc gniazdka ładowarki (z HA)
                        AnchorLayout:
                            opacity: 1 if app.tablet_charging else 0
                            anchor_x: "left"
                            BoxLayout:
                                size_hint: None, None
                                size: 64, 30
                                spacing: 2
                                AnchorLayout:
                                    size_hint_x: None
                                    width: 22
                                    Icon:
                                        icon: "flash"
                                        font_size: "24sp"
                                        color: config.COLOR_SUN_ICON
                                Label:
                                    text: app.tablet_charge_power
                                    font_size: "15sp"
                                    color: config.COLOR_SUN_ICON
                                    text_size: self.size
                                    halign: "left"
                                    valign: "middle"
                    BoxLayout:
                        size_hint_y: None
                        height: 22
                        Label:
                            text: app.tablet_battery_text
                            font_size: "15sp"
                            color: config.COLOR_TEXT_DIM
                            size_hint_x: None
                            width: 44
                        Widget:
                # sam czas - data jest na kartce z kalendarza
                Label:
                    text: root.time_text
                    markup: True
                    font_size: "80sp"
                    bold: True
                # stan połączeń: Wi-Fi (zielona = jest sieć), pod nią Home Assistant
                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: None
                    width: 40
                    padding: [0, 14]
                    spacing: 12
                    Icon:
                        icon: app.wifi_icon
                        font_size: "30sp"
                        color: config.COLOR_OK if app.wifi_ok else config.COLOR_ERROR
                        pos_hint: {"center_x": 0.5}
                    Icon:
                        icon: "home-assistant"
                        font_size: "30sp"
                        color: {"ok": config.COLOR_OK, "error": config.COLOR_ERROR}.get(app.ha_state, config.COLOR_TEXT_DIM)
                        pos_hint: {"center_x": 0.5}

            # Pogoda - dotknięcie otwiera szczegóły
            WeatherCard:
                on_release: root.open_weather_details()
                orientation: "vertical"
                size_hint_y: None
                height: 324
                spacing: 4
                BoxLayout:
                    size_hint_y: None
                    height: 96
                    spacing: 16
                    WeatherIcon:
                        condition: root.weather_condition
                        night: root.weather_night
                        size: 100, 100
                        pos_hint: {"center_y": 0.5}
                    # opis warunków: długi (np. "Częściowe zachmurzenie") w 2 wierszach
                    Label:
                        text: root.weather_text
                        font_size: "30sp" if "\n" in root.weather_text else "36sp"
                        line_height: 0.95
                        max_lines: 2
                        text_size: self.size
                        halign: "left"
                        valign: "middle"
                    BoxLayout:
                        orientation: "vertical"
                        size_hint_x: None
                        # szerokość według tekstu temperatury - reszta miejsca dla opisu warunków
                        width: max(temp_label.texture_size[0], 150)
                        padding: [0, 10]
                        # temperatura + odczuwalna (niebieska: zimniej, czerwona: cieplej)
                        Label:
                            id: temp_label
                            markup: True
                            text: root.weather_temp + ("  [size=28sp]" + root.weather_feels + "[/size]" if root.weather_feels else "")
                            font_size: "38sp"
                            text_size: None, self.height
                            halign: "right"
                            valign: "bottom"
                        Label:
                            text: root.weather_range
                            font_size: "19sp"
                            color: config.COLOR_TEXT_DIM
                            text_size: self.size
                            halign: "right"
                            valign: "top"
                BoxLayout:
                    id: forecast

            # Czujniki po 2 w wierszu, nieparzysty ostatni na całą szerokość
            # (wypełniane w StartScreen.on_sensors)
            BoxLayout:
                id: sensors
                orientation: "vertical"
                spacing: 12
                size_hint_y: None
                height: 2 * 132 + 12

            Widget:

        # ===== prawa kolumna: kartka z kalendarza =====
        # górna część (dzień tygodnia, liczba, miesiąc) -> tabela miesiąca,
        # dolna część (święta, wydarzenia, imieniny, przysłowia) -> lista wydarzeń
        BoxLayout:
            orientation: "vertical"
            spacing: 0
            canvas.before:
                Color:
                    rgba: config.COLOR_CARD
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [config.CARD_RADIUS]
            # jak w zrywanym kalendarzu: po lewej słońce, pośrodku dzień, po prawej Księżyc
            TouchBox:
                size_hint_y: None
                height: 304
                padding: [14, 16, 14, 6]
                on_release: root.open_month()
                # słońce: wschód i zachód dziś -> okno "Słońce w roku"
                TouchBox:
                    orientation: "vertical"
                    size_hint_x: None
                    width: 140
                    spacing: 2
                    on_release: root.open_sun()
                    AnchorLayout:
                        anchor_x: "left"
                        size_hint_y: None
                        height: 60
                        Icon:
                            icon: "weather-sunny"
                            font_size: "48sp"
                            color: config.COLOR_SUN_ICON
                    AstroRow:
                        icon: "weather-sunset-up"
                        time: root.kartka_sunrise
                    AstroRow:
                        icon: "weather-sunset-down"
                        time: root.kartka_sunset
                    Label:
                        text: root.kartka_daylength
                        font_size: "15sp"
                        color: config.COLOR_TEXT_DIM
                        size_hint_y: None
                        height: 24
                        text_size: self.size
                        halign: "left"
                        valign: "middle"
                    Widget:
                BoxLayout:
                    orientation: "vertical"
                    Label:
                        text: root.kartka_weekday
                        font_size: "30sp"
                        color: config.COLOR_ERROR if root.kartka_red else config.COLOR_TEXT
                        size_hint_y: None
                        height: 44
                    Label:
                        text: root.kartka_day
                        font_size: "150sp"
                        bold: True
                        color: config.COLOR_ERROR if root.kartka_red else config.COLOR_TEXT
                    Label:
                        text: root.kartka_month
                        font_size: "26sp"
                        color: config.COLOR_TEXT_DIM
                        size_hint_y: None
                        height: 38
                # Księżyc: faza, wschód i zachód dziś -> okno faz Księżyca
                TouchBox:
                    orientation: "vertical"
                    size_hint_x: None
                    width: 140
                    spacing: 2
                    on_release: root.open_moon()
                    AnchorLayout:
                        anchor_x: "right"
                        size_hint_y: None
                        height: 60
                        MoonDisc:
                            phase: root.kartka_moon_phase
                            size_hint: None, None
                            size: 50, 50
                    AstroRow:
                        icon: "arrow-up"
                        icon_color: 0.96, 0.93, 0.80, 1
                        time: root.kartka_moonrise
                        align: "right"
                    AstroRow:
                        icon: "arrow-down"
                        icon_color: 0.96, 0.93, 0.80, 1
                        time: root.kartka_moonset
                        align: "right"
                    Label:
                        text: root.kartka_moon_name
                        font_size: "15sp"
                        color: config.COLOR_TEXT_DIM
                        size_hint_y: None
                        height: 24
                        text_size: self.size
                        halign: "right"
                        valign: "middle"
                    Widget:
            Divider:
            TouchBox:
                on_release: root.open_events()
                padding: [22, 14, 18, 14]
                # przycinanie tekstu do kafelka (dużo świąt / przysłów)
                StencilView:
                    Label:
                        pos: self.parent.pos
                        size: self.parent.size
                        text: root.kartka_text
                        markup: True
                        font_size: "20sp"
                        line_height: 1.1
                        text_size: self.size
                        halign: "left"
                        valign: "top"
